{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": "error",
    "import/no-duplicates": "error",
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["src/entrypoints/**/main.tsx", "vitest.setup.ts", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "wxt.config.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "e2e/**/*.ts",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "scripts/**/*.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/entrypoints/background/index.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/entrypoints/inferenceWorker/**/*.ts",
        "src/features/inference/model/createInferenceWorker/index.ts"
      ],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["src/features/modelInstall/model/downloadModelFiles/index.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.spec.tsx"],
      "rules": {
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off"
      }
    },
    {
      "files": ["src/app/optionsApp/index.tsx"],
      "rules": {
        "react-perf/jsx-no-new-function-as-prop": "off"
      }
    },
    {
      "files": ["e2e/specs/**/*.e2e.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [".output", ".wxt", "node_modules", "coverage"]
}
